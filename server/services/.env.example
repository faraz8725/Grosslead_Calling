PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ai_calling_crm
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:5173

# Public HTTPS URL of this backend. Use your deployed backend URL or ngrok URL.
# Example: https://your-subdomain.ngrok-free.app
PUBLIC_BASE_URL=

# Vobiz outbound calling credentials
VOBIZ_ACCOUNT_SID=
VOBIZ_API_TOKEN=
VOBIZ_PHONE_NUMBER=+91XXXXXXXXXX

# Speech-to-text, LLM and text-to-speech
DEEPGRAM_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh

# Optional existing settings
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
